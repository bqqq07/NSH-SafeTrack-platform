{% extends "base.html" %}
{% block title %}{{ sup.name }}{% endblock %}
{% block content %}
<section class="report">
  <header class="report-header">
    <div class="report-head-left">
      <img class="report-logo" src="{{ url_for('static', filename='img/logo.png') }}" alt="Company logo">
    </div>
    <div class="report-head-center">
      <h1>{{ sup.name }} <span class="muted mono">({{ sup.supervisor_code }})</span></h1>
      <p class="muted">Week: {{ ws }} → {{ we }}</p>
    </div>
    <div class="report-head-right"></div>
  </header>

  <section class="card">
    <div class="grid4">
      <div>
        <div class="muted">Employees</div>
        <div style="font-size:22px;font-weight:700">{{ kpi_target }}</div>
      </div>
      <div>
        <div class="muted">Evaluated (this week)</div>
        <div style="font-size:22px;font-weight:700">{{ kpi_done }} / {{ kpi_target }}</div>
      </div>
      <div>
        <div class="muted">Coverage%</div>
        <div style="font-size:22px;font-weight:700">{% if kpi_coverage is not none %}{{ '%.0f'|format(kpi_coverage) }}%{% else %}—{% endif %}</div>
      </div>
      <div>
        <div class="muted">Avg Score (this week)</div>
        <div style="font-size:22px;font-weight:700">{{ avg_score if avg_score is not none else '—' }}</div>
      </div>
    </div>
  </section>

  <section class="card">
    <h2>Not Evaluated Yet ({{ not_done|length }})</h2>
    <table class="table">
      <thead><tr><th>Name</th><th>Emp. No</th><th>Department</th></tr></thead>
      <tbody>
        {% for e in not_done %}
        <tr>
          <td>{{ e.name }}</td>
          <td class="mono">{{ e.emp_number }}</td>
          <td>{{ e.department or '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="3" class="center muted">All employees evaluated this week.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2>Evaluated ({{ done|length }})</h2>
    <table class="table">
      <thead><tr><th>Name</th><th>Emp. No</th><th>Department</th></tr></thead>
      <tbody>
        {% for e in done %}
        <tr>
          <td>{{ e.name }}</td>
          <td class="mono">{{ e.emp_number }}</td>
          <td>{{ e.department or '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="3" class="center muted">No evaluations yet this week.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <div class="no-print actions">
    <a class="btn" href="{{ url_for('site_supervisors') }}">Back</a>
  </div>
</section>
{% endblock %}
