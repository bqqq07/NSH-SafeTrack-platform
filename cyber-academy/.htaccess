# أنواع الملفات اللازمة لمحرك Python (WebAssembly) ووحدات الجافاسكربت
AddType application/wasm .wasm
AddType text/javascript .mjs

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm text/javascript application/javascript application/json text/css text/html image/svg+xml
</IfModule>

# ملفات المحرك ما تتغير: نخلي المتصفح يحفظها سنة (تتحمّل مرة وحدة فقط)
<IfModule mod_headers.c>
  <FilesMatch "^(pyodide\.asm\.wasm|python_stdlib\.zip|pyodide\.asm\.mjs|pyodide\.mjs|pyodide-lock\.json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
